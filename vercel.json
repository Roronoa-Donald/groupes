{
  "version": 2,
  "buildCommand": "node scripts/check-db.js",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "^/_auth/admin/?$", "dest": "public/admin.html" },
    { "src": "^/$", "dest": "public/index.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
